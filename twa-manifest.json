{
  "packageId": "com.momentry.app",
  "host": "momentry-smoky.vercel.app",
  "name": "Momentry",
  "launcherName": "Momentry",
  "display": "standalone",
  "themeColor": "#14100f",
  "themeColorDark": "#14100f",
  "navigationColor": "#14100f",
  "navigationColorDark": "#14100f",
  "navigationDividerColor": "#14100f",
  "navigationDividerColorDark": "#14100f",
  "backgroundColor": "#14100f",
  "enableNotifications": true,
  "shortcuts": [
    {
      "name": "Add Memory",
      "short_name": "Add Memory",
