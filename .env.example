[TEMPLATE]
# Momentry — environment variables
#
# Copy this file to `.env` and fill in the
# values from your Supabase project:
#   Supabase Dashboard → Project Settings → API

# Public Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key — safe to expose in the
# browser (RLS protects the database)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Web Push public key — OPTIONAL. The app now
# fetches it at runtime from the push Edge
# Function (GET /functions/v1/push). Set it
# only as a build-time override.
# VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
#
# Required server-side secret (set with
#   supabase secrets set VAPID_PUBLIC_KEY=...
#   supabase secrets set VAPID_PRIVATE_KEY=...
#   supabase secrets set VAPID_SUBJECT="mailto:you@example.com")
# or simply run: npm run setup:push

# ------------------------------------------
# Server-side only (Supabase Edge Function
# secrets — set with:
#   supabase secrets set GEMINI_API_KEY=...)
# These must NEVER be committed or prefixed
# with VITE_.
# ------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash   # optional; the function auto-falls-back and auto-discovers current models
