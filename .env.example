# Momentry — environment variables
#
# Copy this file to `.env` and fill in the
# values from your Supabase project:
#   Supabase Dashboard → Project Settings → API

# Public Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key — safe to expose in the
# browser (RLS protects the database)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ------------------------------------------
# Server-side only (Supabase Edge Function
# secrets — set with:
#   supabase secrets set GEMINI_API_KEY=...)
# These must NEVER be committed or prefixed
# with VITE_.
# ------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash
